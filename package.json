{
  "name": "pet-studio",
  "private": true,
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/brain"
  ],
  "scripts": {
    "dev": "npm run dev -w @pet-studio/desktop",
    "desktop": "node scripts/tauri.mjs dev",
    "build": "npm run build -w @pet-studio/desktop",
    "build:mac": "node scripts/build-mac.mjs",
    "build:trial": "node scripts/build-mac.mjs --trial",
    "build:desktop": "node scripts/tauri.mjs build --bundles app",
    "test": "tsc -p apps/brain && tsx --test tests/*.test.ts tests/brain/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "release": "npm run build:desktop && python3 scripts/package_release.py",
    "test:live": "tsx tests/brain/live.ts",
    "build:brain": "node scripts/build-brain.mjs",
    "test:models": "tsx tests/brain/model-checks.ts",
    "build:lab": "node scripts/build-file-transfer-lab.mjs",
    "test:lab": "tsx --test tests/file-transfer/*.test.ts",
    "format": "prettier --ignore-path= --write \"apps/desktop/src/**/*.{ts,css,html}\" \"apps/brain/src/**/*.ts\" \"apps/shared/**/*.{ts,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"!**/vendor/**\" && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "bun": "1.4.4",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "gsap": "^3.15.1"
  }
}
